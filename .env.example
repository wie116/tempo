# Copiá este archivo como .env y completá con los datos de tu proyecto Supabase.
# Están en el panel: Project Settings → Data API / API Keys
# Sin estas variables la app funciona igual, pero solo en este navegador.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Dejalo apagado hasta desplegar las Edge Functions y configurar OAuth.
VITE_GOOGLE_CALENDAR_ENABLED=false
